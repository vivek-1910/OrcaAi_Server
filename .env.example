PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Active AI provider: Google AI Studio (server-side only)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_PRIMARY_MODEL=gemini-3.5-flash-lite
GOOGLE_FALLBACK_MODEL=gemini-3.1-flash-lite

# Legacy rollback provider (not used by the active chat route)
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Voice provider (server-side only)
SARVAM_API_KEY=

# API-only data providers
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=
NDMA_CAP_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
INCOIS_API_BASE_URL=
INCOIS_API_KEY=
INCOIS_API_ENDPOINT=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com
NASA_POWER_BASE_URL=https://power.larc.nasa.gov
